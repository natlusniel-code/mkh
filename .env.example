# MarketHub environment variables.
# Copy to `.env` and fill in real values. Never commit `.env`.

# Postgres connection string (Neon / any Postgres).
DATABASE_URL=

# Session signing secret for auth cookies.
JWT_SECRET=

# Object storage (product images, uploads).
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Optional: port for the production server (defaults to 3000).
# PORT=3000
