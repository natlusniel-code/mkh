# MarketHub environment variables.
# Copy to `.env` and fill in real values. Never commit `.env`.
#
# On Vercel, set these under Settings -> Environment Variables for BOTH
# Production and Preview, then redeploy. `GET /api/health` reports the NAMES of
# any required variable that is still missing (never the values).

# ── Required ────────────────────────────────────────────────────────────────
# Postgres connection string (Neon / Supabase / any Postgres).
# For a serverless host, prefer the POOLED connection string.
DATABASE_URL=

# Session signing secret for auth cookies. Any long random string.
JWT_SECRET=

# ── Database driver ─────────────────────────────────────────────────────────
# "http" = Neon serverless HTTP driver (one request per query, no TCP pool).
#          REQUIRED on serverless hosts such as Vercel: a TCP pool is built once
#          per frozen container and cannot be relied on between invocations.
# "tcp"  = node-postgres pool. Correct for a resident process (local dev, Docker,
#          a long-running Node server). This is the default when unset.
DB_DRIVER=http

# Max TCP connections the pool may hold (only used by the "tcp" driver).
# DB_POOL_MAX=5

# ── Object storage (product images, uploads) ────────────────────────────────
# The app never holds raw S3 credentials. It holds ONE durable scoped credential
# (APP_STORAGE_TOKEN) and asks the platform presign endpoint for a short-lived
# signed URL per operation. Product images are served through the app's own
# /app-storage/* proxy, so WITHOUT these two the catalogue renders with no
# images even when the database is reachable.
APP_STORAGE_PRESIGN_URL=
APP_STORAGE_TOKEN=

# ── Admin ───────────────────────────────────────────────────────────────────
# Shared secret required by the admin sign-up form at /admin/register.
# Without it, admin sign-up is DISABLED (nobody can promote themselves).
# Choose a long random value and treat it like a password.
ADMIN_SIGNUP_CODE=

# Optional: comma/space separated emails that are auto-promoted to admin on
# login. Handy for bootstrapping the first administrator.
# ADMIN_EMAILS=

# ── Optional ────────────────────────────────────────────────────────────────
# Port for the production server (defaults to 3000).
# PORT=3000
