import "dotenv/config";
import pg from "pg";
const p = new pg.Pool({ connectionString: process.env.DATABASE_URL });
const a = await p.query("select c.name, c.slug, count(pr.id)::int as n from categories c left join products pr on pr.category_id=c.id and pr.status='active' group by c.id,c.name,c.slug order by c.sort_order");
console.log("per-category:", JSON.stringify(a.rows));
const b = await p.query("select count(*)::int n, count(category_id)::int withcat from products where status='active'");
console.log("products:", JSON.stringify(b.rows));
const c = await p.query("select slug,name from products where status='active' order by sold_count desc limit 3");
console.log("top:", JSON.stringify(c.rows));
await p.end();
